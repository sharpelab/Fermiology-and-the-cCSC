{
    "font.family": "sans-serif",
    "axes.labelsize": 8,
    "axes.titlesize": 8,
    "font.size": 9,
    "legend.title_fontsize": 7,
    "legend.fontsize": 7,
    "xtick.labelsize": 7,
    "ytick.labelsize": 7,

    "xtick.direction": "in",
    "xtick.top": true,
    "ytick.direction": "in",
    "ytick.right": true,

    "xtick.major.size": 2.8,
