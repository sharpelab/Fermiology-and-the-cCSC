{
    "font.family": "sans-serif",
    "font.size": 14,
    "axes.labelsize": 14,
    "axes.titlesize": 14,
    "xtick.labelsize": 12,
    "ytick.labelsize": 12,
    "legend.fontsize": 12,
    "legend.title_fontsize": 14,

    "xtick.direction": "in",
    "xtick.top": true,
    "ytick.direction": "in",
    "ytick.right": true,

    "xtick.major.size": 5,
    "xtick.major.width": 1.5,
    "xtick.minor.size": 2.5,
    "xtick.minor.width": 1.5,

    "ytick.major.size": 5,
    "ytick.major.width": 1.5,
    "ytick.minor.size": 2.5,
    "ytick.minor.width": 1.5,

    "axes.linewidth": 1.5,
    "lines.linewidth": 2.5,

    "figure.figsize": [4.854, 3.0]
}
